---
import qa from '../../qa.json';
// qa.json and public/qa/*.webp are written from a real `layoza qa` run on this site's own build.
const frames = [
  { w: 1440, cls: 'd', label: 'Desktop' },
  { w: 768, cls: 't', label: 'Tablet' },
  { w: 375, cls: 'm', label: 'Mobile' },
];
// Illustrative annotations: the kinds of finding the gate reports. Not findings on this page.
const notes = [
  { f: 'd', x: 8, y: 22, t: 'Contrast 4.5:1 checked' },
  { f: 'd', x: 58, y: 70, t: 'Primary CTA above the fold' },
  { f: 't', x: 10, y: 40, t: 'No horizontal overflow' },
  { f: 'm', x: 6, y: 60, t: 'Tap targets ≥ 44px' },
];
---
<section class="band silver qa" aria-labelledby="qa-title" data-qa>
  <div class="wrap">
    <p class="sheet"><b>08</b> Browser QA</p>
    <div class="head">
      <h2 id="qa-title" class="h-lg caps" data-reveal>Good design <span class="accent">isn't a guess.</span></h2>
      <p class="lede" data-reveal="0.1">Layoza drives real Chromium at 1440, 768 and 375 pixels, runs its craft, accessibility and lab performance checks, and hands your agent the list to fix before it says done. Below: this page, checked by Layoza.</p>
    </div>
    <div class="browser">
      <div class="chrome mono" aria-hidden="true"><i></i><i></i><i></i><span>chromium · layoza qa · {qa.date}</span></div>
      <div class="frames">
        {frames.map((f) => (
          <figure class={`dev ${f.cls}`}>
            <div class="screen">
              <img src={`/qa/${f.w}.webp`} alt={`This home page captured by layoza qa at ${f.w} pixels wide`} loading="lazy" decoding="async" width={qa.shots[String(f.w)]?.[0] ?? 720} height={qa.shots[String(f.w)]?.[1] ?? 450} />
              <span class="scan" aria-hidden="true"></span>
              {notes.filter((n) => n.f === f.cls).map((n, i) => (
                <span class="pin mono" style={`left:${n.x}%;top:${n.y}%;--d:${0.6 + i * 0.5}s`} aria-hidden="true">{n.t}</span>
              ))}
            </div>
            <figcaption class="mono"><span>{f.label} · {f.w}px</span><span class="ok">{qa.viewports[String(f.w)] ?? '—'}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
    <dl class="report mono">
      <div><dt>Run</dt><dd>{qa.date}</dd></div>
      <div><dt>Errors</dt><dd>{qa.errors}</dd></div>
      <div><dt>Warnings</dt><dd>{qa.warnings}</dd></div>
      <div><dt>Lab LCP · CLS</dt><dd>{qa.lab}</dd></div>
    </dl>
    <p class="fine">Report: a real run on this build. Pins on the screenshots are example labels for the kinds of check, not findings. Lab numbers come from one headless run on a dev machine, not field data from real visitors.</p>
  </div>
</section>

<style>
  .browser { border: 1.5px solid var(--ink); background: var(--white); }
  .chrome { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-bottom: 1.5px solid var(--ink); font-size: 12px; color: var(--mute-light); }
  .chrome i { width: 11px; height: 11px; border-radius: 50%; border: 1.5px solid var(--ink); }
  .chrome span { margin-left: 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .frames { display: grid; grid-template-columns: 6fr 3.2fr 1.6fr; gap: clamp(12px, 1.8vw, 24px); align-items: end; padding: clamp(12px, 1.8vw, 24px); background: repeating-linear-gradient(0deg, transparent 0 23px, rgba(20, 25, 34, 0.05) 23px 24px), repeating-linear-gradient(90deg, transparent 0 23px, rgba(20, 25, 34, 0.05) 23px 24px); }
  .dev { margin: 0; min-width: 0; }
  .screen { position: relative; border: 1px solid var(--ink); background: var(--navy); overflow: hidden; }
  .d .screen { aspect-ratio: 16 / 10; }
  .t .screen { aspect-ratio: 3 / 4; }
  .m .screen { aspect-ratio: 9 / 19; }
  .screen img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .scan { position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--uv); box-shadow: 0 0 16px 3px rgba(129, 104, 255, 0.6); opacity: 0; }
  :global(.js-motion) .qa.live .scan { opacity: 1; animation: qscan 2.4s var(--ease) 1 forwards; }
  @keyframes qscan { from { top: 0; } to { top: 100%; opacity: 0; } }
  .pin { position: absolute; background: var(--uv); color: var(--white); font-size: 11px; padding: 3px 7px; white-space: nowrap; max-width: 90%; overflow: hidden; text-overflow: ellipsis; }
  .pin::before { content: '✓ '; }
  :global(.js-motion) .qa .pin { opacity: 0; transform: translateY(6px); transition: opacity 0.4s var(--ease) var(--d), transform 0.4s var(--ease) var(--d); }
  :global(.js-motion) .qa.live .pin { opacity: 1; transform: none; }
  figcaption { display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; padding: 8px 0 0; font-size: 12px; color: var(--mute-light); }
  .ok { color: var(--ink); }
  .report { display: grid; grid-template-columns: repeat(4, 1fr); border: 1.5px solid var(--ink); border-top: 0; background: var(--paper); }
  .report div { padding: 14px 16px; border-right: 1px solid var(--rule-light); }
  .report div:last-child { border: 0; }
  dt { font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--mute-light); }
  dd { margin: 4px 0 0; font-size: 18px; color: var(--ink); }
  .fine { margin-top: 14px; font-size: 14px; color: var(--mute-light); max-width: 80ch; }
  @media (max-width: 860px) {
    .frames { grid-template-columns: 1fr 0.55fr; }
    .d { grid-column: 1 / -1; }
    .report { grid-template-columns: 1fr 1fr; }
    .report div:nth-child(-n + 2) { border-bottom: 1px solid var(--rule-light); }
  }
  @media (max-width: 520px) { .m .pin { display: none; } }
</style>
