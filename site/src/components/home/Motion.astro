---
import MotionPlayground from '../islands/MotionPlayground';
---
<section class="band graphite motion" aria-labelledby="motion-title">
  <div class="wrap">
    <p class="sheet"><b>05</b> Motion</p>
    <div class="head">
      <h2 id="motion-title" class="h-lg caps" data-reveal>Motion with intention. <span class="accent">Not motion for attention.</span></h2>
      <p class="lede" data-reveal="0.1">Layoza's catalogue holds 76 motion mechanics, each tied to the kind of site it belongs on. Your agent is dealt the ones that fit the brief. Six of them, live: pick one and only that one plays.</p>
    </div>
    <MotionPlayground client:visible />
  </div>
</section>

<style>
  :global(.mp) { --k: 1; }
  :global(.mp.mp-calm) { --k: 1.8; }
  :global(.mp-bar) { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; margin-bottom: 18px; font-size: 13px; }
  :global(.mp-seg) { display: inline-flex; border: 1px solid var(--rule-dark); }
  :global(.mp-seg label) { position: relative; display: grid; place-items: center; min-height: 44px; padding: 0 16px; cursor: pointer; text-transform: uppercase; letter-spacing: 0.08em; color: #c9d0db; }
  :global(.mp-seg label + label) { border-left: 1px solid var(--rule-dark); }
  :global(.mp-seg input) { position: absolute; opacity: 0; inset: 0; cursor: pointer; margin: 0; }
  :global(.mp-seg label:has(input:checked)) { background: var(--lime); color: #0b0f05; }
  :global(.mp-seg label:has(input:focus-visible)) { outline: 2px solid var(--lime); outline-offset: 2px; }
  :global(.mp-replay) { margin-left: auto; min-height: 44px; padding: 0 16px; background: transparent; border: 1px solid var(--lime); color: var(--lime); cursor: pointer; font: inherit; text-transform: uppercase; letter-spacing: 0.08em; }
  :global(.mp-replay:hover) { background: var(--lime); color: #0b0f05; }
  :global(.mp-replay:disabled) { opacity: 0.4; cursor: default; }
  :global(.mp-note) { margin-top: 14px; font-size: 13px; color: var(--gray); }

  /* Bento: tiles of different size, paper sheets on the graphite ground */
  :global(.mp-grid) { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: minmax(150px, auto); gap: 14px; }
  /* Tiles are paper on a dark band, so small violet text takes the deeper light-ground violet. */
  :global(.mp-tile) { --uv: #5f45e6; display: grid; grid-template-rows: auto 1fr auto; background: var(--paper); color: var(--ink); border: 1.5px solid transparent; transition: border-color 0.2s, opacity 0.3s; min-width: 0; }
  :global(.mp-tile.on) { border-color: var(--lime); box-shadow: 0 0 0 3px rgba(200, 255, 97, 0.25); }
  :global(.mp-tile.off) { opacity: 0.28; }
  :global(.mp-xl) { grid-column: span 2; grid-row: span 2; }
  :global(.mp-tall) { grid-row: span 2; }
  :global(.mp-head) { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; text-align: left; width: 100%; padding: 12px 14px; min-height: 48px; border: 0; border-bottom: 1px solid var(--rule-light); background: transparent; cursor: pointer; color: var(--ink); }
  :global(.mp-head:hover .mp-meta) { color: var(--uv); }
  :global(.mp-name) { font-weight: 700; font-size: 16px; letter-spacing: -0.01em; }
  :global(.mp-meta) { font-size: 12px; color: var(--mute-light); text-transform: uppercase; letter-spacing: 0.06em; }
  :global(.mp-tile.on .mp-meta) { color: var(--uv); }
  :global(.mp-use) { padding: 10px 14px 12px; font-size: 14px; color: #2f3643; border-top: 1px solid var(--rule-light); }
  :global(.mp-demo) { display: grid; place-items: center; padding: 20px 14px; overflow: hidden; min-height: 150px; }

  /* odometer */
  :global(.mp-odo) { font-weight: 700; font-size: clamp(30px, 3.6vw, 56px); letter-spacing: -0.03em; line-height: 1; display: flex; align-items: center; flex-wrap: wrap; justify-content: center; text-align: center; }
  :global(.mp-wheel) { display: inline-block; height: 1em; overflow: hidden; color: var(--uv); }
  :global(.mp-wheel span) { display: block; line-height: 1; animation: mp-roll calc(1.6s * var(--k)) cubic-bezier(.2,.8,.2,1) both; --to: -7em; }
  :global(.mp-wheel.w2 span) { --to: -6em; animation-duration: calc(2s * var(--k)); }
  :global(.mp-wheel.w2) { margin-right: 0.3em; }
  :global(.still .mp-wheel span) { animation: none; transform: translateY(var(--to)); }
  @keyframes mp-roll { from { transform: translateY(0); } to { transform: translateY(var(--to)); } }

  /* seam split */
  :global(.mp-seam) { position: relative; font-weight: 700; font-size: clamp(26px, 2.6vw, 40px); letter-spacing: -0.04em; line-height: 1; }
  :global(.mp-seam .under) { color: var(--uv); }
  :global(.mp-seam .top), :global(.mp-seam .bot) { position: absolute; inset: 0; background: var(--paper); color: var(--ink); }
  :global(.mp-seam .top) { clip-path: inset(0 0 50% 0); animation: mp-up calc(1.2s * var(--k)) 0.4s cubic-bezier(.7,0,.2,1) forwards; }
  :global(.mp-seam .bot) { clip-path: inset(50% 0 0 0); animation: mp-down calc(1.2s * var(--k)) 0.4s cubic-bezier(.7,0,.2,1) forwards; }
  :global(.still .mp-seam .top), :global(.still .mp-seam .bot) { display: none; }
  @keyframes mp-up { to { transform: translateY(-110%); } }
  @keyframes mp-down { to { transform: translateY(110%); } }

  /* floor plan */
  :global(.mp-plan) { width: min(100%, 320px); }
  :global(.mp-plan path) { fill: none; stroke: var(--ink); stroke-width: 3; stroke-dasharray: 1; stroke-dashoffset: 1; animation: mp-draw calc(2.4s * var(--k)) ease-out forwards; }
  :global(.mp-plan .door) { stroke: var(--uv); animation-delay: 1.8s; animation-duration: 0.8s; }
  :global(.still .mp-plan path) { animation: none; stroke-dashoffset: 0; }
  @keyframes mp-draw { to { stroke-dashoffset: 0; } }

  /* receipt */
  :global(.mp-qty) { display: flex; gap: 10px; align-items: center; margin-bottom: 14px; font-size: 14px; }
  :global(.mp-qty input) { width: 140px; accent-color: var(--uv); }
  :global(.mp-receipt) { width: min(100%, 260px); background: var(--white); border: 1px solid var(--rule-light); padding: 12px 14px; font-size: 13px; }
  :global(.mp-receipt .ln) { display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px dashed var(--rule-light); animation: mp-print calc(0.35s * var(--k)) ease-out both; }
  :global(.mp-receipt .tot) { font-weight: 500; border: 0; padding-top: 10px; }
  :global(.still .mp-receipt .ln) { animation: none; }
  @keyframes mp-print { from { opacity: 0; transform: translateY(-8px); } }

  /* audit log */
  :global(.mp-log) { list-style: none; padding: 0; width: min(100%, 300px); font-size: 14px; }
  :global(.mp-log li) { padding: 6px 0; border-bottom: 1px solid var(--rule-light); animation: mp-print calc(0.4s * var(--k)) ease-out both; }
  :global(.mp-log li:nth-child(2)) { animation-delay: calc(0.4s * var(--k)); } :global(.mp-log li:nth-child(3)) { animation-delay: calc(0.8s * var(--k)); } :global(.mp-log li:nth-child(4)) { animation-delay: calc(1.2s * var(--k)); }
  :global(.mp-log span) { display: inline-block; width: 46px; color: var(--uv); }
  :global(.still .mp-log li) { animation: none; }

  /* ticket */
  :global(.mp-ticket) { display: flex; margin-left: 36px; width: min(100%, 320px); height: 110px; }
  :global(.mp-ticket .stub) { width: 70px; background: var(--uv); color: var(--white); writing-mode: vertical-rl; display: grid; place-items: center; font-size: 12px; letter-spacing: 0.2em; border-right: 2px dashed var(--paper); animation: mp-tear calc(1s * var(--k)) 0.5s cubic-bezier(.6,0,.3,1) forwards; transform-origin: bottom right; }
  :global(.mp-ticket .body) { flex: 1; background: var(--ink); color: var(--white); padding: 16px; display: grid; align-content: center; gap: 6px; font-size: 13px; }
  :global(.mp-ticket b) { font-size: 18px; color: var(--lime); }
  :global(.still .mp-ticket .stub) { animation: none; transform: translate(-24px, 30px) rotate(-14deg); }
  @keyframes mp-tear { to { transform: translate(-24px, 30px) rotate(-14deg); } }

  @media (max-width: 1000px) {
    :global(.mp-grid) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    :global(.mp-grid) { grid-template-columns: 1fr; }
    :global(.mp-xl), :global(.mp-tall) { grid-column: auto; grid-row: auto; }
    :global(.mp-replay) { margin-left: 0; }
  }
</style>
