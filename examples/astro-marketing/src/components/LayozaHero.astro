---
interface Props {
  title?: string;
  subtitle?: string;
  ctaLabel?: string;
}
const {
  title = "Zero-Bundle Content Architecture at Edge Scale",
  subtitle = "Ship server-rendered islands with verifiable typography, automatic token preservation, and zero hydration tax.",
  ctaLabel = "Deploy Astro Island"
} = Astro.props;
---
<section class="layoza-astro-hero" aria-labelledby="astro-hero-heading">
  <div class="layoza-container">
    <span class="eyebrow">ASTRO 5 // ISLANDS ARCHITECTURE</span>
    <h1 id="astro-hero-heading">{title}</h1>
    <p class="lead">{subtitle}</p>
    <a href="#deploy" class="cta-btn">{ctaLabel}</a>
  </div>
</section>

<style>
  .layoza-astro-hero {
    background: var(--color-bg, #FBF9F5);
    color: var(--color-fg, #141619);
    padding: clamp(4rem, 9vw, 7rem) 1.5rem;
  }
  .layoza-container {
    max-width: 1160px;
    margin: 0 auto;
  }
  .eyebrow {
    font-family: monospace;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    color: #1D4ED8;
    display: block;
    margin-bottom: 0.85rem;
  }
  h1 {
    font-size: clamp(2.4rem, 4.8vw, 4.1rem);
    line-height: 1.07;
    margin: 0 0 1.25rem;
  }
  .lead {
    font-size: 1.125rem;
    max-width: 60ch;
    margin: 0 0 2rem;
  }
  .cta-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.8rem 1.5rem;
    background: #1D4ED8;
    color: #FFFFFF;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-btn { transition: none !important; }
  }
</style>
