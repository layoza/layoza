{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "840px",
      "wideSize": "1240px"
    },
    "spacing": {
      "units": ["px", "rem", "vh", "vw", "%"],
      "spacingSizes": [
        { "slug": "30", "size": "1.5rem", "name": "Small" },
        { "slug": "50", "size": "3rem", "name": "Medium" },
        { "slug": "70", "size": "5rem", "name": "Large" }
      ]
    },
    "color": {
      "palette": [
        { "slug": "canvas", "color": "#F8F7F4", "name": "Canvas Background" },
        { "slug": "ink", "color": "#141619", "name": "Primary Ink" },
        { "slug": "accent", "color": "#1849A9", "name": "Brand Accent" },
        { "slug": "surface", "color": "#FFFFFF", "name": "Card Surface" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Instrument Serif",
          "fontFamily": "\"Instrument Serif\", Georgia, serif"
        },
        {
          "slug": "body",
          "name": "Plus Jakarta Sans",
          "fontFamily": "\"Plus Jakarta Sans\", system-ui, sans-serif"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "lineHeight": "1.6"
    }
  }
}
