      "css": ".ds-seg{display:inline-flex;border:1.5px solid var(--ink,#0D3A2C);border-radius:3px;padding:3px;gap:3px;background:var(--paper,#F3F7F4)}.ds-seg button{padding:.55em 1.1em;min-height:42px;border:0;border-radius:2px;background:transparent;color:var(--ink,#0D3A2C);font-family:var(--f-text,'Schibsted Grotesk',system-ui,sans-serif);font-weight:600;font-size:.95rem;cursor:pointer}.ds-seg button[aria-pressed=true]{background:var(--ink,#0D3A2C);color:var(--paper,#F3F7F4)}.ds-seg button:focus-visible{outline:3px solid var(--focus,#F0A23B);outline-offset:2px}"
